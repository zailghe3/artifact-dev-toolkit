    "openai": "7.65.0",
    "pg": "8.23.1",
    "undici": "8.13.1",
    "ws": "^8.23.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3"
  },
