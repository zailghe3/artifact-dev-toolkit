{
  "name": "artifact-dev-toolkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "issue:render": "node scripts/render-feature-issue.mjs",
    "issue:validate": "node scripts/validate-feature-issue-template.mjs",
    "issue:create-from-requests": "node scripts/create-feature-issues-from-requests.mjs",
    "issue:validate-request": "node scripts/validate-feature-request.mjs",
    "test": "node --test test/*.test.mjs",
    "artifacts:validate": "node scripts/validate-artifact-repository.mjs",
    "toolchain:validate": "node scripts/validate-toolchain.mjs && npm run secrets:validate",
    "maintenance:report": "node scripts/maintenance-report.mjs",
    "secrets:validate": "node scripts/validate-secrets.mjs",
    "runner-revision:validate": "node scripts/validate-runner-revision.mjs",
    "test:workflow-runtime-integration": "npm --prefix adt-runtime run build && node --test test/integration/workflow-runtime-integration.test.mjs test/integration/agent-tool-runtime-integration.test.mjs",
    "runtime-revision:validate": "node scripts/validate-runtime-revision.mjs",
    "test:worker-runtime": "node scripts/smoke-test-worker.mjs",
    "advisor:definitions": "node scripts/create-advisor-definitions.mjs",
    "test:agent-tool-runtime-integration": "npm --prefix adt-runtime run build && node --test test/integration/agent-tool-runtime-integration.test.mjs test/integration/advisor-runtime-integration.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@xyflow/react": "^13.0.3",
    "lucide-react": "1.82.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "miniflare": "5.20261123.1-beta",
    "postcss": "^8.5.33",
    "react-test-renderer": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": "26.x",
    "npm": "11.21.3"
  },
  "packageManager": "npm@11.21.3"
}
