{
  "name": "artifact-dev-toolkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "issue:render": "node scripts/render-feature-issue.mjs",
    "issue:validate": "node scripts/validate-feature-issue-template.mjs",
    "issue:create-from-requests": "node scripts/create-feature-issues-from-requests.mjs",
    "issue:validate-request": "node scripts/validate-feature-request.mjs",
    "test": "node --test test/*.test.mjs",
    "artifacts:validate": "node scripts/validate-artifact-repository.mjs",
    "toolchain:validate": "node scripts/validate-toolchain.mjs && npm run secrets:validate",
    "maintenance:report": "node scripts/maintenance-report.mjs",
    "secrets:validate": "node scripts/validate-secrets.mjs",
    "runner-revision:validate": "node scripts/validate-runner-revision.mjs",
    "test:workflow-runtime-integration": "npm --prefix adt-runtime run build && node --test test/integration/workflow-runtime-integration.test.mjs",
    "runtime-revision:validate": "node scripts/validate-runtime-revision.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "miniflare": "^5.20260921.1-alpha",
    "postcss": "^8.5.18",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.138.0"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.4.2"
  },
  "packageManager": "npm@11.4.2"
}
